#include <cs50.h>
#include <stdio.h>

int main(void)
{
    int x = get_int("What's x?\n");
    int y = get_int("What's y?\n");
    char z = get_char("Which Operation?\n");

    if (z == '+')
    {
        printf("Sum=%i\n", x + y);
    }
    else if (z == '-')
    {
        printf("Difference=%i\n", x - y);
    }
    else if (z == '*')
    {
        printf("Product=%i\n", x * y);
    }
    else if (z == '/')
    {
        printf("Quotient=%i\n", x / y);
        printf("Remainder=%i\n", x % y);
    }

}
